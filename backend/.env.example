# Cấu hình Kho lưu trữ chính (Primary Database) - Chọn 1 trong các hình thức bên dưới:

# 1. MySQL (Khuyên dùng trên VPS Linux/Windows):
# PRIMARY_DB_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/smart_soil_db

# 2. Microsoft SQL Server (Dùng với SSMS / Azure SQL / Windows Server):
# PRIMARY_DB_URL=mssql+pyodbc://sa:your_password@127.0.0.1:1433/smart_soil_db?driver=ODBC+Driver+17+for+SQL+Server

# 3. PostgreSQL:
# PRIMARY_DB_URL=postgresql+psycopg2://postgres:your_password@127.0.0.1:5432/smart_soil_db

# Kho lưu trữ phụ khi mất kết nối mạng hoặc DB chính bảo trì (SQLite cục bộ):
OFFLINE_SQLITE_URL=sqlite:///./soil_system.db
